# ============================================
# CaptionCraft — .gitignore
# ============================================

# Environment Variables (NEVER commit these!)
.env
.env.local
.env.production
.env.*.local
server/.env
client/.env

# Dependencies
node_modules/
**/node_modules/

# Build output
client/dist/
client/build/

# Vite cache
client/.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temp files (video processing)
server/temp/
temp/
*.tmp

# IDE
.vscode/
.idea/
*.swp
*.swo

# Coverage
coverage/
